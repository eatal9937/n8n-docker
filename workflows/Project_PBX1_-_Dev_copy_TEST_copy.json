      "parameters": {
        "jsCode": "const text = $json.content.parts[0].text;\nconst cleanText = text.replace(/```json|```/g, '').trim();\ntry {\n    const parsed = JSON.parse(cleanText);\n    parsed.create_ticket = (parsed.create_ticket === true || parsed.create_ticket === 'true');\n    return parsed;\n} catch (e) {\n    return { \n        create_ticket: true,\n        subject: 'Parsing Error',\n        description: 'Failed to parse Gemini output: ' + text,\n        type: 'incident',\n        priority: '1'\n    };\n}"
      },
