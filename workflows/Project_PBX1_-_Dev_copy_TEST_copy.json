    {
      "parameters": {
        "jsCode": "const text = $json.stdout || '';\nconst numberMatch = text.match(/callernumber\\s*=\\s*(\\d+)/i);\nconst nameMatch = text.match(/callerid\\s*=\\s*\"([^\"]+)\"/i);\n\nlet callernumber = numberMatch ? numberMatch[1] : '';\nlet callername = nameMatch ? nameMatch[1] : 'Unknown Caller';\n\n// If callernumber is empty, try to parse from wav filename\nif (!callernumber) {\n    try {\n        const wavFileName = $('Read/Write Files from Disk').first().binary.data.fileName;\n        const parts = wavFileName.replace('.wav', '').split('-');\n        if (parts.length >= 4) {\n            callernumber = parts[2];\n        }\n    } catch (e) {}\n}\n\nconst searchFilter = callernumber.length >= 9 ? callernumber.slice(-9) : callernumber;\n\nreturn { callernumber, callername, searchFilter };"
      },
