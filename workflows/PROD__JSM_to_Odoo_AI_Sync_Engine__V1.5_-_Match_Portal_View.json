    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://jadssupport.atlassian.net/rest/api/3/search/jql",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"jql\": \"statusCategory != Done ORDER BY created DESC\", \"maxResults\": 50, \"fields\": [\"summary\", \"description\", \"status\", \"reporter\", \"priority\", \"created\", \"issuetype\"] }",
        "options": {
          "timeout": 30000
        }
      },
      "id": "node-2",
      "name": "Fetch All Open Requests",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        0,
        304
      ],
      "credentials": {
        "httpBasicAuth": {
          "id": "VXVWhT3RImLF55GL",
          "name": "Jira API Token (JADS)"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "issues",
        "options": {}
      },
      "id": "node-3",
      "name": "Split Issues",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 3,
      "position": [
        224,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "function adfToText(content) { if (!content) return \"\"; if (typeof content === \"string\") return content; let text = \"\"; if (Array.isArray(content)) { content.forEach(c => text += adfToText(c) + \" \"); } else if (content.content) { text += adfToText(content.content); } else if (content.text) { text += content.text; } return text.trim(); } const items = $input.all(); return items.map(item => { const f = item.json.fields || {}; return { json: { jira_key: item.json.key || \"UNKNOWN\", summary: f.summary || \"No Summary\", status: f.status?.name || \"Open\", reporter: f.reporter?.displayName || \"Unknown\", description: adfToText(f.description) || \"No Description\" } }; });"
      },
      "id": "node-4",
      "name": "Normalize JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        304
      ]
    },
    {
      "parameters": {
        "resource": "custom",
        "customResource": "helpdesk.ticket",
        "operation": "getAll",
        "limit": 1,
        "options": {}
      },
